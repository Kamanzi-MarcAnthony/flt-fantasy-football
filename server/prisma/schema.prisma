generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int                   @id @default(autoincrement())
  name               String
  email              String                @unique
  password           String
  role               UserRole              @default(PLAYER)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  refreshTokenHash   String?
  isActive           Boolean               @default(true)
  fantasyMemberships FantasyLeagueMember[]
  fantasyTeams       FantasyTeam[]
  leaguesCreated     League[]              @relation("LeagueCreator")
}

model League {
  id                      Int                   @id @default(autoincrement())
  name                    String
  location                String?
  createdById             Int
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  matchDay                String?
  matchTime               String?
  maxTransfers            Int                   @default(3)
  transferDeadlineMinutes Int                   @default(180)
  fantasyMembers          FantasyLeagueMember[]
  fantasyTeams            FantasyTeam[]
  gameweeks               Gameweek[]
  createdBy               User                  @relation("LeagueCreator", fields: [createdById], references: [id])
  matches                 Match[]
  players                 Player[]
}

model FantasyLeagueMember {
  id       Int      @id @default(autoincrement())
  userId   Int
  leagueId Int
  joinedAt DateTime @default(now())
  league   League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, leagueId])
}

model Player {
  id                    Int                          @id @default(autoincrement())
  leagueId              Int
  name                  String
  photoUrl              String?
  position              PlayerPosition
  ovr                   Int
  price                 Decimal                      @db.Decimal(10, 2)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  deletedAt             DateTime?
  fantasyGameweekScores FantasyPlayerGameweekScore[]
  captainOfTeams        FantasyTeam[]                @relation("TeamCaptain")
  viceCaptainOfTeams    FantasyTeam[]                @relation("TeamViceCaptain")
  teamPlayers           FantasyTeamPlayer[]
  events                MatchEvent[]
  league                League                       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
}

model FantasyTeam {
  id                   Int                          @id @default(autoincrement())
  userId               Int
  leagueId             Int
  name                 String
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  bank                 Decimal                      @db.Decimal(10, 2)
  captainId            Int?
  viceCaptainId        Int?
  playerGameweekScores FantasyPlayerGameweekScore[]
  captain              Player?                      @relation("TeamCaptain", fields: [captainId], references: [id])
  league               League                       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  viceCaptain          Player?                      @relation("TeamViceCaptain", fields: [viceCaptainId], references: [id])
  gameweekScores       FantasyTeamGameweekScore[]
  players              FantasyTeamPlayer[]

  @@unique([userId, leagueId])
}

model FantasyTeamPlayer {
  id            Int         @id @default(autoincrement())
  teamId        Int
  playerId      Int
  purchasePrice Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  player        Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team          FantasyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, playerId])
}

model Match {
  id         Int       @id @default(autoincrement())
  leagueId   Int
  gameweekId Int?

  league   League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  gameweek Gameweek? @relation(fields: [gameweekId], references: [id], onDelete: SetNull)

  matchDate DateTime

  events MatchEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MatchEvent {
  id        Int            @id @default(autoincrement())
  matchId   Int
  playerId  Int
  type      MatchEventType
  createdAt DateTime       @default(now())
  match     Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player    Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model Gameweek {
  id        Int      @id @default(autoincrement())
  leagueId  Int
  number    Int
  startDate DateTime
  endDate   DateTime?

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  matches Match[]

  scores       FantasyTeamGameweekScore[]
  playerScores FantasyPlayerGameweekScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leagueId, number])
}

model FantasyTeamGameweekScore {
  id         Int         @id @default(autoincrement())
  teamId     Int
  gameweekId Int
  points     Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  gameweek   Gameweek    @relation(fields: [gameweekId], references: [id], onDelete: Cascade)
  team       FantasyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, gameweekId])
}

model FantasyPlayerGameweekScore {
  id         Int         @id @default(autoincrement())
  teamId     Int
  playerId   Int
  gameweekId Int
  points     Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  gameweek   Gameweek    @relation(fields: [gameweekId], references: [id], onDelete: Cascade)
  player     Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team       FantasyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, playerId, gameweekId])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PLAYER
  FANTASY_USER
}

enum LeagueStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum PlayerPosition {
  GK
  DEF
  MID
  ST
}

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
}

enum MatchEventType {
  GOAL
  ASSIST
  CLEAN_SHEET
}
