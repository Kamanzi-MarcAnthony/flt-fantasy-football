generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PLAYER
}

enum LeagueStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum PlayerPosition {
  GK
  DEF
  MID
  ST
}

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
}

enum MatchEventType {
  GOAL
  ASSIST
  CLEAN_SHEET
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(PLAYER)
  refreshTokenHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaguesCreated League[]      @relation("LeagueCreator")
  fantasyTeams   FantasyTeam[]
}

model League {
  id             Int          @id @default(autoincrement())
  name           String
  startDate      DateTime
  endDate        DateTime
  recurring      Boolean      @default(false)
  recurrenceType String?
  location       String?
  scoringConfig  Json
  status         LeagueStatus @default(DRAFT)

  createdById Int
  createdBy   User @relation("LeagueCreator", fields: [createdById], references: [id])

  players      Player[]
  fantasyTeams FantasyTeam[]
  matches      Match[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Player {
  id       Int    @id @default(autoincrement())
  leagueId Int
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  name     String
  photoUrl String?
  position PlayerPosition
  ovr      Int
  price    Decimal        @db.Decimal(10, 2)

  teamPlayers FantasyTeamPlayer[]
  events      MatchEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FantasyTeam {
  id       Int @id @default(autoincrement())
  userId   Int
  leagueId Int

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  name   String
  budget Decimal @db.Decimal(10, 2)

  players FantasyTeamPlayer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, leagueId])
}

model FantasyTeamPlayer {
  id            Int     @id @default(autoincrement())
  teamId        Int
  playerId      Int
  purchasePrice Decimal @db.Decimal(10, 2)

  team   FantasyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teamId, playerId])
}

model Match {
  id       Int    @id @default(autoincrement())
  leagueId Int
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  matchDate DateTime
  status    MatchStatus @default(SCHEDULED)

  events MatchEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MatchEvent {
  id       Int @id @default(autoincrement())
  matchId  Int
  playerId Int

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  type  MatchEventType
  value Int            @default(1)

  createdAt DateTime @default(now())
}
